# Bootstrap credentials for Infisical. Copy to .env.infisical and fill in.
# These are the ONLY secrets stored outside Infisical.
#
#   cp .env.infisical.example .env.infisical
#   set -a && . ./.env.infisical && set +a
#
# Obtain these from the Infisical UI: Organisation -> Access Control ->
# Machine Identities -> openar -> Universal Auth.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Which Infisical environment to read. "dev" locally, "prod" in production.
INFISICAL_ENV=dev
