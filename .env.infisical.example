# Infisical connection details. Copy to .env.infisical and fill in.
# This file is the ONLY place these values live outside Infisical itself —
# nothing about the instance is committed to this repository.
#
#   cp .env.infisical.example .env.infisical
#
# scripts/with-secrets.sh sources .env.infisical automatically, so no manual
# export is needed. Real environment variables take precedence over this file.

# Instance URL and project — not credentials, but kept out of the repo so it
# discloses no infrastructure. Find the project id in the Infisical project URL,
# or under Project Settings.
INFISICAL_DOMAIN=
INFISICAL_PROJECT_ID=

# Universal Auth machine identity:
# Organisation -> Access Control -> Machine Identities -> openar -> Universal Auth
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Which Infisical environment to read. "dev" locally, "prod" in production.
INFISICAL_ENV=dev
