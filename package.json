{
  "name": "openar",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc && cp src/api/docs.html dist/api/docs.html",
    "dev:remote": "./scripts/with-secrets.sh tsx watch src/index.ts",
    "start:remote": "./scripts/with-secrets.sh node dist/index.js",
    "etl": "tsx --env-file=.env --use-system-ca src/etl/load.ts",
    "etl:all": "./scripts/with-secrets.sh tsx --use-system-ca src/etl/load.ts --all",
    "etl:current": "./scripts/with-secrets.sh tsx --use-system-ca src/etl/load.ts --current",
    "etl:photos": "./scripts/with-secrets.sh tsx --use-system-ca src/etl/load.ts --photos",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "./scripts/with-secrets.sh drizzle-kit migrate",
    "db:migrate:prod": "./scripts/with-secrets.sh node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:remote": "./scripts/with-secrets.sh vitest run",
    "test:scripts": "sh scripts/with-secrets.test.sh && sh scripts/next-run-delay.test.sh && node scripts/docs-md.test.mjs",
    "test:wrapper": "sh scripts/with-secrets.test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@hono/node-server": "^2.0.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pg": "^8.13"
  },
  "devDependencies": {
    "@types/pg": "^8.11",
    "drizzle-kit": "^0.31",
    "playwright": "^1.60.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7",
    "vitest": "^4.1.10"
  }
}
