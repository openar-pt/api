{
  "name": "openar",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && cp src/api/docs.html dist/api/docs.html",
    "etl:all": "tsx --env-file=.env --use-system-ca src/etl/load.ts --all",
    "etl:current": "tsx --env-file=.env --use-system-ca src/etl/load.ts --current",
    "etl:photos": "tsx --env-file=.env --use-system-ca src/etl/load.ts --photos",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@hono/node-server": "^1.13",
    "drizzle-orm": "^0.44",
    "hono": "^4.7",
    "pg": "^8.13"
  },
  "devDependencies": {
    "@types/pg": "^8.11",
    "drizzle-kit": "^0.31",
    "playwright": "^1.60.0",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^4.1.7"
  }
}
